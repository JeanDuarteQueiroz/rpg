        escolha = input("Ação: ").strip()
        
        if escolha == "1":
            # 1. Escolhe o alvo
            # 2. Calcula acerto (1d20 + Força/Destreza + Proficiência da Arma)
            # 3. Aplica Dano na CA do inimigo
            break
        elif escolha == "2":
            # Mostra a lista de habilidades/magias e chama o .executar()
            break
        elif escolha == "3":
            # Usa poções ou arremessa itens
            break
        elif escolha == "4":
            print("Tentaste fugir...") # (Pode exigir rolagem de Destreza no futuro)
            break
        else:
