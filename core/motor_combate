import random
from time import sleep

def rolar_iniciativa(entidade):
    """Rola 1d20 + Modificador de Destreza para definir a ordem."""
    return random.randint(1, 20) + entidade.modificador("destreza")

def iniciar_combate(jogador, inimigos_na_cena: list, expressao_rolagem_func):
    """O Maestro da Batalha. Controla os turnos até que um lado vença."""
    
    print("\n⚔️ O COMBATE COMEÇOU! ⚔️")
    
    # 1. Filtra apenas os inimigos que estão realmente hostis e vivos
    hostis = [inimigo for inimigo in inimigos_na_cena if inimigo.agressivo and not inimigo.morte]
    
    if not hostis:
        print("Falso alarme. Ninguém quer lutar contigo agora.")
        return True # Retorna à exploração

    # 2. Rola a Iniciativa e cria a Fila de Turnos (Fila de Batalha)
    fila_batalha = [{"entidade": jogador, "iniciativa": rolar_iniciativa(jogador)}]
    for inimigo in hostis:
        fila_batalha.append({"entidade": inimigo, "iniciativa": rolar_iniciativa(inimigo)})
    
    # Ordena a fila do maior valor para o menor
    fila_batalha.sort(key=lambda x: x["iniciativa"], reverse=True)
    
    print("\nOrdem de Iniciativa:")
    for participante in fila_batalha:
        print(f" - {participante['entidade'].nome} ({participante['iniciativa']})")
    sleep(1)

    # 3. O Loop Principal do Combate
    combate_ativo = True
    turno_numero = 1
    
    while combate_ativo:
        print(f"\n{'='*20} TURNO {turno_numero} {'='*20}")
        
        for participante in fila_batalha:
            combatente = participante["entidade"]
            
            # Pula quem já morreu
            if combatente.hp_atual <= 0:
                continue
                
            # Verifica se o combate acabou antes do turno deste personagem
            hostis_vivos = [i for i in hostis if i.hp_atual > 0 and i.agressivo]
            if jogador.hp_atual <= 0 or not hostis_vivos:
                combate_ativo = False
                break # Sai do loop de participantes
            
            # --- TURNO DO JOGADOR ---
            if combatente == jogador:
                turno_do_jogador(jogador, hostis_vivos, expressao_rolagem_func)
                
            # --- TURNO DO INIMIGO ---
            else:
                # Inteligência Artificial Básica do Inimigo
                print(f"\n> Turno de {combatente.nome}...")
                sleep(1)
                # (Aqui o NPC ataca o jogador!)
                
        turno_numero += 1

    # 4. Fim do Combate (Vitória, Fuga ou Derrota)
    if jogador.hp_atual <= 0:
        print("\n☠️ Foste derrotado...")
        return False
    else:
        print("\n🏆 Sobreviveste ao combate!")
        return True


